<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_dest_location" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.dest.location</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <widget name="lb_seller_tiers"/>
                <field name="dest_location_id" optional="show"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_history_tree_inherit_discount" model="ir.ui.view">
        <field name="name">purchase.history.list.inherit.discount</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_history_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="warehouse_id" string="Almacén"/>
            </field>
            <field name="price_unit_product_uom" position="after">
                <field name="discount" string="Desc. %"/>
                <field name="price_unit_discounted" widget="monetary" string="Precio con descuento"/>
            </field>
        </field>
    </record>
</odoo>
