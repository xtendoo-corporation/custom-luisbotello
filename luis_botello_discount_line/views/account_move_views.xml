<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_discount_line" model="ir.ui.view">
        <field name="name">account.move.form.inherit.discount.line</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="after">
                <field name="discount_line" string="Desc. Lin" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='name']" position="after">
                <field name="discount_line" string="Desc. Lin" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
