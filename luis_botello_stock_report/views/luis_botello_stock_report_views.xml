<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_luis_botello_stock_report_search" model="ir.ui.view">
        <field name="name">luis_botello.stock_report.search</field>
        <field name="model">luis_botello.stock_report</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="categ_id"/>
                <filter string="Con Stock" name="has_stock" domain="[('qty', '&gt;', 0)]"/>
            </search>
        </field>
    </record>

    <record id="view_luis_botello_stock_report_list" model="ir.ui.view">
        <field name="name">luis_botello.stock_report.list</field>
        <field name="model">luis_botello.stock_report</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list string="Stock consolidado" create="0">
                <field name="product_id"/>
                <field name="available_qty" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_luis_botello_stock_report_pivot" model="ir.ui.view">
        <field name="name">luis_botello.stock_report.pivot</field>
        <field name="model">luis_botello.stock_report</field>
        <field name="arch" type="xml">
            <pivot string="Stock por Almacén" display_quantity="0" sample="1">
                <field name="product_id" type="row"/>
                <field name="warehouse_id" type="col"/>
                <field name="available_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_luis_botello_stock_report" model="ir.actions.act_window">
        <field name="name">Stock consolidado</field>
        <field name="res_model">luis_botello.stock_report</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="context">{'search_default_has_stock': 1}</field>
    </record>

    <menuitem id="menu_luis_botello_stock_report"
              name="Stock consolidado"
              parent="stock.menu_warehouse_report"
              action="action_luis_botello_stock_report"
              sequence="10"/>
</odoo>
