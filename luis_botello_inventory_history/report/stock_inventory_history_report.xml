<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_stock_inventory_history" model="ir.actions.report">
        <field name="name">Conteo de inventario</field>
        <field name="model">stock.inventory.history</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">luis_botello_inventory_history.report_stock_inventory_history</field>
        <field name="report_file">luis_botello_inventory_history.report_stock_inventory_history</field>
        <field name="print_report_name">'Conteo %s' % object.name.replace('/', '-')</field>
        <field name="binding_model_id" ref="model_stock_inventory_history"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_stock_inventory_history">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Conteo de inventario <span t-field="o.name"/></h2>
                        <div class="row mb-3">
                            <div class="col-4"><strong>Almacén:</strong> <span t-field="o.warehouse_id"/></div>
                            <div class="col-4"><strong>Fecha:</strong> <span t-field="o.date"/></div>
                            <div class="col-4"><strong>Usuario:</strong> <span t-field="o.user_id"/></div>
                        </div>
                        <table class="table table-sm o_inventory_history_table"
                               style="border-collapse: collapse; width: 100%;">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Cantidad anterior</th>
                                    <th class="text-end">Cantidad contada</th>
                                    <th class="text-end">Diferencia</th>
                                    <th class="text-end">Coste unit.</th>
                                    <th class="text-end">Valor contado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line" style="page-break-inside: avoid;">
                                    <td style="border: 1px solid #000; background-color: #fff; color: #000;"><span t-field="line.product_id.display_name"/></td>
                                    <td class="text-end" style="border: 1px solid #000; background-color: #fff; color: #000;"><span t-field="line.theoretical_qty"/></td>
                                    <td class="text-end" style="border: 1px solid #000; background-color: #fff; color: #000;"><span t-field="line.counted_qty"/></td>
                                    <td class="text-end" style="border: 1px solid #000; background-color: #fff; color: #000;"><strong t-field="line.difference_qty"/></td>
                                    <td class="text-end" style="border: 1px solid #000; background-color: #fff; color: #000;"><span t-field="line.unit_cost"/></td>
                                    <td class="text-end" style="border: 1px solid #000; background-color: #fff; color: #000;"><span t-field="line.counted_value"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="text-end mt-3">
                            <strong>Valor total del inventario: </strong>
                            <span t-field="o.total_value"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
