<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_inventory_history_list" model="ir.ui.view">
        <field name="name">stock.inventory.history.list</field>
        <field name="model">stock.inventory.history</field>
        <field name="arch" type="xml">
            <list string="Conteos de inventario" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="date"/>
                <field name="warehouse_id"/>
                <field name="user_id"/>
                <field name="line_count" sum="Productos"/>
                <field name="diff_line_count" sum="Con diferencia"/>
                <field name="total_value" sum="Valor total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_stock_inventory_history_form" model="ir.ui.view">
        <field name="name">stock.inventory.history.form</field>
        <field name="model">stock.inventory.history</field>
        <field name="arch" type="xml">
            <form string="Conteo de inventario" create="false" edit="false" delete="false">
                <header>
                    <button name="%(action_report_stock_inventory_history)d" string="Imprimir"
                        type="action" class="btn-primary"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="warehouse_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="line_count"/>
                            <field name="diff_line_count"/>
                            <field name="total_value"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list string="Líneas" create="false" edit="false" delete="false"
                              decoration-danger="difference_qty &lt; 0"
                              decoration-success="difference_qty &gt; 0">
                            <field name="product_id"/>
                            <field name="lot_id" groups="stock.group_production_lot" optional="show"/>
                            <field name="location_id" optional="show"/>
                            <field name="theoretical_qty"/>
                            <field name="counted_qty"/>
                            <field name="difference_qty"/>
                            <field name="unit_cost" optional="show"/>
                            <field name="counted_value" sum="Valor total" optional="show"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="uom_id" optional="hide"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stock_inventory_history_search" model="ir.ui.view">
        <field name="name">stock.inventory.history.search</field>
        <field name="model">stock.inventory.history</field>
        <field name="arch" type="xml">
            <search string="Conteos de inventario">
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="user_id"/>
                <field name="line_ids" string="Producto" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="filter_date" string="Fecha" date="date"/>
                <filter name="with_diff" string="Con diferencias" domain="[('diff_line_count', '&gt;', 0)]"/>
                <group>
                    <filter name="group_warehouse" string="Almacén" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_date" string="Fecha" context="{'group_by': 'date:month'}"/>
                    <filter name="group_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_inventory_history" model="ir.actions.act_window">
        <field name="name">Histórico de inventarios</field>
        <field name="res_model">stock.inventory.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stock_inventory_history_search"/>
        <field name="context">{'search_default_group_warehouse': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay conteos de inventario</p>
            <p>Cada vez que se aplique un inventario se guardará aquí un documento por
            almacén con la cantidad que había, la contada y la diferencia.</p>
        </field>
    </record>

    <record id="view_stock_inventory_history_line_pivot" model="ir.ui.view">
        <field name="name">stock.inventory.history.line.pivot</field>
        <field name="model">stock.inventory.history.line</field>
        <field name="arch" type="xml">
            <pivot string="Detalle de conteos">
                <field name="warehouse_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="theoretical_qty" type="measure"/>
                <field name="counted_qty" type="measure"/>
                <field name="difference_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_stock_inventory_history_line_list" model="ir.ui.view">
        <field name="name">stock.inventory.history.line.list</field>
        <field name="model">stock.inventory.history.line</field>
        <field name="arch" type="xml">
            <list string="Detalle de conteos" create="false" edit="false" delete="false"
                  decoration-danger="difference_qty &lt; 0" decoration-success="difference_qty &gt; 0">
                <field name="date"/>
                <field name="history_id"/>
                <field name="warehouse_id"/>
                <field name="product_id"/>
                <field name="theoretical_qty"/>
                <field name="counted_qty"/>
                <field name="difference_qty"/>
            </list>
        </field>
    </record>

    <record id="view_stock_inventory_history_line_search" model="ir.ui.view">
        <field name="name">stock.inventory.history.line.search</field>
        <field name="model">stock.inventory.history.line</field>
        <field name="arch" type="xml">
            <search string="Detalle de conteos">
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="history_id"/>
                <filter name="filter_date" string="Fecha" date="date"/>
                <filter name="with_diff" string="Con diferencia" domain="[('difference_qty', '!=', 0)]"/>
                <group>
                    <filter name="group_warehouse" string="Almacén" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_inventory_history_line" model="ir.actions.act_window">
        <field name="name">Detalle por producto</field>
        <field name="res_model">stock.inventory.history.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_stock_inventory_history_line_search"/>
    </record>

    <menuitem id="menu_stock_inventory_history_root"
        name="Histórico de inventarios"
        parent="stock.menu_warehouse_report" sequence="60"
        groups="stock.group_stock_manager"/>
    <menuitem id="menu_stock_inventory_history"
        name="Conteos por almacén"
        parent="menu_stock_inventory_history_root"
        action="action_stock_inventory_history" sequence="1"/>
    <menuitem id="menu_stock_inventory_history_line"
        name="Detalle por producto"
        parent="menu_stock_inventory_history_root"
        action="action_stock_inventory_history_line" sequence="2"/>
</odoo>
