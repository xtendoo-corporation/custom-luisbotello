<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_luis_botello_report_pos_order_margin_pivot" model="ir.ui.view">
        <field name="name">luis.botello.report.pos.order.margin.pivot</field>
        <field name="model">report.pos.order</field>
        <field name="arch" type="xml">
            <pivot string="Beneficio por periodo" sample="1">
                <field name="date" interval="day" type="row"/>
                <field name="config_id" type="col"/>
                <field name="price_subtotal_excl" type="measure" string="Ventas sin impuestos"/>
                <field name="total_cost" type="measure" string="Coste"/>
                <field name="margin" type="measure" string="Beneficio"/>
            </pivot>
        </field>
    </record>

    <record id="view_luis_botello_report_pos_order_margin_graph" model="ir.ui.view">
        <field name="name">luis.botello.report.pos.order.margin.graph</field>
        <field name="model">report.pos.order</field>
        <field name="arch" type="xml">
            <graph string="Beneficio por periodo" type="bar" sample="1">
                <field name="date" interval="day"/>
                <field name="margin" type="measure" string="Beneficio"/>
            </graph>
        </field>
    </record>

    <record id="view_luis_botello_report_pos_order_margin_list" model="ir.ui.view">
        <field name="name">luis.botello.report.pos.order.margin.list</field>
        <field name="model">report.pos.order</field>
        <field name="arch" type="xml">
            <list string="Beneficio por periodo" create="false" edit="false">
                <field name="date"/>
                <field name="order_id" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="product_qty" optional="show" sum="Cantidad"/>
                <field name="price_subtotal_excl" optional="show" sum="Ventas sin impuestos"/>
                <field name="total_cost" optional="show" sum="Coste"/>
                <field name="margin" optional="show" sum="Beneficio"/>
            </list>
        </field>
    </record>

    <record id="view_luis_botello_report_pos_order_margin_search" model="ir.ui.view">
        <field name="name">luis.botello.report.pos.order.margin.search</field>
        <field name="model">report.pos.order</field>
        <field name="arch" type="xml">
            <search string="Beneficio por periodo">
                <field name="product_id"/>
                <field name="product_categ_id"/>
                <field name="config_id"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <filter name="filter_today" string="Hoy"
                    domain="[('date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter name="filter_yesterday" string="Ayer"
                    domain="[('date', '&gt;=', datetime.datetime.combine(context_today() - relativedelta(days=1), datetime.time(0,0,0))), ('date', '&lt;', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <separator/>
                <filter name="filter_last_7_days" string="Últimos 7 días"
                    domain="[('date', '&gt;=', datetime.datetime.combine(context_today() - relativedelta(days=6), datetime.time(0,0,0)))]"/>
                <filter name="filter_last_30_days" string="Últimos 30 días"
                    domain="[('date', '&gt;=', datetime.datetime.combine(context_today() - relativedelta(days=29), datetime.time(0,0,0)))]"/>
                <filter name="filter_last_90_days" string="Últimos 90 días"
                    domain="[('date', '&gt;=', datetime.datetime.combine(context_today() - relativedelta(days=89), datetime.time(0,0,0)))]"/>
                <separator/>
                <filter name="filter_this_week" string="Esta semana"
                    domain="[('date', '&gt;=', datetime.datetime.combine(context_today() + relativedelta(days=-6, weekday=0), datetime.time(0,0,0)))]"/>
                <filter name="filter_last_week" string="Semana pasada"
                    domain="[('date', '&gt;=', datetime.datetime.combine(context_today() + relativedelta(days=-13, weekday=0), datetime.time(0,0,0))), ('date', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=-6, weekday=0), datetime.time(0,0,0)))]"/>
                <filter name="filter_this_month" string="Este mes"
                    domain="[('date', '&gt;=', datetime.datetime.combine(context_today() + relativedelta(day=1), datetime.time(0,0,0)))]"/>
                <filter name="filter_last_month" string="Mes pasado"
                    domain="[('date', '&gt;=', datetime.datetime.combine(context_today() + relativedelta(day=1, months=-1), datetime.time(0,0,0))), ('date', '&lt;', datetime.datetime.combine(context_today() + relativedelta(day=1), datetime.time(0,0,0)))]"/>
                <filter name="filter_this_year" string="Este año"
                    domain="[('date', '&gt;=', datetime.datetime.combine(context_today() + relativedelta(month=1, day=1), datetime.time(0,0,0)))]"/>
                <separator/>
                <filter name="filter_date" string="Fecha personalizada" date="date"/>
                <separator/>
                <filter name="not_cancelled" string="No cancelados" domain="[('state', '!=', 'cancel')]"/>
                <group>
                    <filter name="group_date" string="Periodo" context="{'group_by': 'date'}"/>
                    <separator/>
                    <filter name="group_config" string="Punto de venta" context="{'group_by': 'config_id'}"/>
                    <filter name="group_categ" string="Categoría de producto" context="{'group_by': 'product_categ_id'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Añade el beneficio a las medidas habituales del análisis estándar -->
    <record id="view_luis_botello_report_pos_order_pivot_inherit" model="ir.ui.view">
        <field name="name">luis.botello.report.pos.order.pivot.inherit</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_report_pos_order_pivot"/>
        <field name="arch" type="xml">
            <field name="price_total" position="after">
                <field name="total_cost" type="measure"/>
                <field name="margin" type="measure"/>
            </field>
        </field>
    </record>

    <record id="action_luis_botello_pos_margin_report" model="ir.actions.act_window">
        <field name="name">Beneficio por periodo</field>
        <field name="res_model">report.pos.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_luis_botello_report_pos_order_margin_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_luis_botello_report_pos_order_margin_graph')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_luis_botello_report_pos_order_margin_list')})]"/>
        <field name="search_view_id" ref="view_luis_botello_report_pos_order_margin_search"/>
        <field name="context">{'search_default_not_cancelled': 1, 'search_default_filter_last_30_days': 1, 'group_by': ['date:day']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay pedidos TPV para analizar.</p>
            <p>Beneficio = ventas sin impuestos - coste de los productos vendidos. Elige el periodo en
            Filtros (hoy, ayer, última semana, último mes...) y la agrupación en Agrupar por.</p>
        </field>
    </record>

    <menuitem id="menu_luis_botello_pos_margin_report"
        name="Beneficio por periodo"
        parent="point_of_sale.menu_point_rep"
        action="action_luis_botello_pos_margin_report"
        sequence="5"
        groups="point_of_sale.group_pos_manager"/>
</odoo>
