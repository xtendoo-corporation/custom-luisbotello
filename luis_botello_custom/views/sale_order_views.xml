<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_discount_line" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.discount.line</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="after">
                <field name="discount_line" string="Desc. Lin" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='discount']" position="after">
                <field name="discount_line" string="Desc. Lin" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
