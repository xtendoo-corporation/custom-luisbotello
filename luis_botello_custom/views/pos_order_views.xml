<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_inherit_discount_line" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.discount.line</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']/list/field[@name='discount']" position="after">
                <field name="discount_line" string="Desc. Lin" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
