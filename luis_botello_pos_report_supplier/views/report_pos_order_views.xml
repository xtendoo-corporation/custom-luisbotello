<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_pos_order_search_supplier" model="ir.ui.view">
        <field name="name">report.pos.order.search.supplier</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_report_pos_order_search"/>
        <field name="arch" type="xml">
            <field name="product_categ_id" position="after">
                <field name="supplier_id"/>
            </field>
            <filter name="product_category" position="after">
                <filter string="Vendor" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
            </filter>
        </field>
    </record>

    <record id="report_pos_order_view_tree_supplier" model="ir.ui.view">
        <field name="name">report.pos.order.view.list.supplier</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="point_of_sale.report_pos_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="product_categ_id" position="after">
                <field name="supplier_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
