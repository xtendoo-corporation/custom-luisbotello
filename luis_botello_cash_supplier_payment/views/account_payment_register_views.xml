<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Extensión del wizard de registro de pago:
        Añade el campo "Crear salida en la sesión actual" visible únicamente
        cuando el diario es de tipo efectivo y las facturas son de proveedor.
    -->
    <record id="account_payment_register_form_inherit_cash_out" model="ir.ui.view">
        <field name="name">account.payment.register.form.cash.supplier.payment</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <!-- Insertar la opción debajo de la fecha, en una fila propia -->
            <xpath expr="//field[@name='payment_date']" position="after">
                <field name="is_cash_payment" invisible="1"/>
                <field name="is_supplier_invoice" invisible="1"/>
                <label
                    for="create_pos_cash_out"
                    string="Crear salida de caja en TPV"
                    invisible="not is_cash_payment or not is_supplier_invoice"
                />
                <div invisible="not is_cash_payment or not is_supplier_invoice">
                    <field
                        name="create_pos_cash_out"
                        widget="boolean_toggle"
                        class="oe_inline"
                        help="Si está marcado, al registrar el pago en efectivo se generará una salida de caja en la sesión de TPV abierta que use ese diario."
                    />
                    <div class="text-muted mt-1">
                        Si activas esta opción, al crear el pago en efectivo se registrará automáticamente una salida de caja en la sesión de TPV abierta asociada al diario seleccionado.
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
