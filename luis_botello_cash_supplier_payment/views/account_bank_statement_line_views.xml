<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_bank_statement_line_pos_cash_out_list" model="ir.ui.view">
        <field name="name">account.bank.statement.line.list.pos.cash.out</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <list string="Salidas de caja POS" create="false" edit="false" delete="false">
                <field name="name" string="Número"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="pos_session_id" string="Sesión"/>
                <field name="supplier_invoice_id" string="Factura proveedor" optional="show"/>
                <field name="supplier_payment_id" string="Pago proveedor" optional="show"/>
                <field name="payment_ref" string="Etiqueta" optional="show"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="view_account_bank_statement_line_pos_cash_out_form" model="ir.ui.view">
        <field name="name">account.bank.statement.line.form.pos.cash.out</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <form string="Salida de caja POS" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="journal_id" readonly="1"/>
                            <field name="pos_session_id" string="Sesión" readonly="1"/>
                            <field name="statement_id" string="Extracto" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="supplier_invoice_id" string="Factura proveedor" readonly="1"/>
                            <field name="supplier_payment_id" string="Pago proveedor" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="payment_ref" string="Etiqueta" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

