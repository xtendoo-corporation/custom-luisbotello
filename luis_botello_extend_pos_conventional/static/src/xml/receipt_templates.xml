<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="luis_botello_extend_pos_conventional.ReceiptHeader" t-inherit="pos_conventional_receipt.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.data.company.name']" position="replace">
            <div style="font-weight: bold; font-size: 13px; text-transform: uppercase;">
                <t t-esc="props.data.pos.config.name" />
            </div>
        </xpath>
    </t>

    <t t-name="luis_botello_extend_pos_conventional.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="inside">
            <div style="text-align: center; font-size: 11px; margin-top: 10px;">
                No Refunds/ No Reembolso
            </div>
        </xpath>
    </t>

    <t t-name="luis_botello_extend_pos_conventional.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//li[@t-if='vals.discount']" position="replace">
            <li t-if="vals.discount" class="price-per-unit">
                <i class="fa fa-tag pe-1"/><em><t t-esc="vals.discount" />% </em> (<t t-esc="vals.discountAmount" />) descuento sobre <t t-esc="vals.noDiscountPrice"/>
            </li>
        </xpath>
    </t>
</templates>
