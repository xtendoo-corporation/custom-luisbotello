<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_slug" model="ir.ui.view">
        <field name="name">pos.config.view.form.inherit.slug</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Acceso Personalizado">
                    <field name="access_slug" placeholder="Identificador (ej. prueba)"/>
                    <field name="access_url" widget="url" invisible="not access_url"/>
                </group>
                <group string="Comportamiento POS">
                    <field name="hide_return_button"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
