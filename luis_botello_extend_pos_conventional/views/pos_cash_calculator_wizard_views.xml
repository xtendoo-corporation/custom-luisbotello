                                    </div>
                                    <label for="qty_010" string="0,10 €" class="m-0 fw-bold ms-2 whitespace-nowrap"/>
                                </div>
                                <div class="col-6 d-flex align-items-center mb-1 px-3">
                                    <div class="input-group" style="width: auto;">
                                        <button name="decrement_050" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-minus small"/></button>
                                        <field name="qty_050" nolabel="1" class="form-control text-center px-1" style="max-width: 50px; font-size: 1.1rem;"/>
                                        <button name="increment_050" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-plus small"/></button>
                                    </div>
                                    <label for="qty_050" string="0,50 €" class="m-0 fw-bold ms-2 whitespace-nowrap"/>
                                </div>
                                <div class="col-6 d-flex align-items-center mb-1 px-3">
                                    <div class="input-group" style="width: auto;">
                                        <button name="decrement_005" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-minus small"/></button>
                                        <field name="qty_005" nolabel="1" class="form-control text-center px-1" style="max-width: 50px; font-size: 1.1rem;"/>
                                        <button name="increment_005" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-plus small"/></button>
                                    </div>
                                    <label for="qty_005" string="0,05 €" class="m-0 fw-bold ms-2 whitespace-nowrap"/>
                                </div>
                                <div class="col-6 d-flex align-items-center mb-1 px-3">
                                    <div class="input-group" style="width: auto;">
                                        <button name="decrement_002" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-minus small"/></button>
                                        <field name="qty_002" nolabel="1" class="form-control text-center px-1" style="max-width: 50px; font-size: 1.1rem;"/>
                                        <button name="increment_002" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-plus small"/></button>
                                    </div>
                                    <label for="qty_002" string="0,02 €" class="m-0 fw-bold ms-2 whitespace-nowrap"/>
                                </div>
                                <div class="col-6 d-flex align-items-center mb-1 px-3">
                                    <div class="input-group" style="width: auto;">
                                        <button name="decrement_001" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-minus small"/></button>
                                        <field name="qty_001" nolabel="1" class="form-control text-center px-1" style="max-width: 50px; font-size: 1.1rem;"/>
                                        <button name="increment_001" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-plus small"/></button>
                                    </div>
                                    <label for="qty_001" string="0,01 €" class="m-0 fw-bold ms-2 whitespace-nowrap"/>
                                </div>
                            </div>
                        </div>

                        <!-- Total Section (Right Side) -->
                        <div class="col-12 col-md-4 bg-light p-4 d-flex flex-column align-items-center justify-content-center border-start shadow-sm rounded-end">
                            <h4 class="text-uppercase text-muted fw-bold mb-1">Total</h4>
                            <div class="display-3 fw-bolder text-primary">
                                <field name="total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </div>
                            <field name="currency_id" invisible="1"/>
                            <field name="parent_model" invisible="1"/>
                            <field name="parent_res_id" invisible="1"/>
                        </div>
                    </div>
                    <footer class="mt-auto border-top p-3 bg-white">
                        <button name="action_confirm" string="Confirmar" type="object" class="btn-primary btn-lg px-4"/>
                        <button name="action_clear" string="Limpiar" type="object" class="btn-secondary btn-lg px-4"/>
                        <button string="Cancelar" class="btn-secondary btn-lg px-4" special="cancel"/>
                    </footer>
                </form>
            </xpath>
        </field>
    </record>
</odoo>






