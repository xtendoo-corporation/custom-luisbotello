                                </div>
                                <div class="col-6 d-flex align-items-center mb-1 px-3">
                                    <div class="input-group" style="width: auto;">
                                        <button name="decrement_020" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-minus small"/></button>
                                        <field name="qty_020" nolabel="1" class="form-control text-center px-1" style="max-width: 50px; font-size: 1.1rem;"/>
                                        <button name="increment_020" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-plus small"/></button>
                                    </div>
                                    <label for="qty_020" string="0,20 €" class="m-0 fw-bold ms-2 whitespace-nowrap"/>
                                </div>
                                <div class="col-6 d-flex align-items-center mb-1 px-3">
                                    <div class="input-group" style="width: auto;">
                                        <button name="decrement_1" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-minus small"/></button>
                                        <field name="qty_1" nolabel="1" class="form-control text-center px-1" style="max-width: 50px; font-size: 1.1rem;"/>
                                        <button name="increment_1" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-plus small"/></button>
                                    </div>
                                    <label for="qty_1" string="1 €" class="m-0 fw-bold ms-2 whitespace-nowrap"/>
