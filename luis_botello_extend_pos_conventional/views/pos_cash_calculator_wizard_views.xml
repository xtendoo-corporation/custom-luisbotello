<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_cash_calculator_wizard_form_inherit" model="ir.ui.view">
        <field name="name">pos.cash.calculator.wizard.form.inherit</field>
        <field name="model">pos.cash.calculator.wizard</field>
        <field name="inherit_id" ref="pos_conventional_cash_calculator.view_pos_cash_calculator_wizard_form"/>
        <field name="arch" type="xml">
