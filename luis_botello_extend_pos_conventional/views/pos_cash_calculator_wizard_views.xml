                                    <div class="o_cash_calc_card shadow-sm">
                                        <div class="o_cash_qty_group">
                                            <div class="d-flex">
                                                <button name="decrement_200" type="object" class="btn btn-primary border" title="Restar">
                                                    <i class="fa fa-minus"/>
                                                </button>
                                                <field name="qty_200" nolabel="1"/>
                                                <button name="increment_200" type="object" class="btn btn-primary border" title="Sumar">
                                                    <i class="fa fa-plus"/>
                                                </button>
                                            </div>
                                            <span class="o_cash_label">200 €</span>
                                        </div>
                                    </div>
                                </div>
