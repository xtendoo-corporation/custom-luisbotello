<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_cash_calculator_wizard_form_inherit" model="ir.ui.view">
        <field name="name">pos.cash.calculator.wizard.form.inherit</field>
        <field name="model">pos.cash.calculator.wizard</field>
        <field name="inherit_id" ref="pos_conventional_cash_calculator.view_pos_cash_calculator_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="replace">
                <form string="Recuento de efectivo">
                    <div class="row m-0 p-0">
                        <!-- Money Grid (Left Side) -->
                        <div class="col-12 col-md-8 p-3">
                            <h5 class="text-uppercase fw-bold border-bottom pb-2 mb-3">Billetes</h5>
                            <div class="row g-2 mb-4">
                                <div class="col-6 d-flex align-items-center mb-1 px-3">
                                    <div class="input-group" style="width: auto;">
                                        <button name="decrement_200" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-minus small"/></button>
                                        <field name="qty_200" nolabel="1" class="form-control text-center px-1" style="max-width: 50px; font-size: 1.1rem;"/>
                                        <button name="increment_200" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-plus small"/></button>
                                    </div>
                                    <label for="qty_200" string="200 €" class="m-0 fw-bold ms-2 whitespace-nowrap"/>
                                </div>
                                <div class="col-6 d-flex align-items-center mb-1 px-3">
                                    <div class="input-group" style="width: auto;">
                                        <button name="decrement_20" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-minus small"/></button>
                                        <field name="qty_20" nolabel="1" class="form-control text-center px-1" style="max-width: 50px; font-size: 1.1rem;"/>
                                        <button name="increment_20" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-plus small"/></button>
                                    </div>
                                    <label for="qty_20" string="20 €" class="m-0 fw-bold ms-2 whitespace-nowrap"/>
                                </div>
                                <div class="col-6 d-flex align-items-center mb-1 px-3">
                                    <div class="input-group" style="width: auto;">
                                        <button name="decrement_100" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-minus small"/></button>
                                        <field name="qty_100" nolabel="1" class="form-control text-center px-1" style="max-width: 50px; font-size: 1.1rem;"/>
                                        <button name="increment_100" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-plus small"/></button>
                                    </div>
                                    <label for="qty_100" string="100 €" class="m-0 fw-bold ms-2 whitespace-nowrap"/>
                                </div>
                                <div class="col-6 d-flex align-items-center mb-1 px-3">
                                    <div class="input-group" style="width: auto;">
                                        <button name="decrement_10" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-minus small"/></button>
                                        <field name="qty_10" nolabel="1" class="form-control text-center px-1" style="max-width: 50px; font-size: 1.1rem;"/>
                                        <button name="increment_10" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-plus small"/></button>
                                    </div>
                                    <label for="qty_10" string="10 €" class="m-0 fw-bold ms-2 whitespace-nowrap"/>
                                </div>
                                <div class="col-6 d-flex align-items-center mb-1 px-3">
                                    <div class="input-group" style="width: auto;">
                                        <button name="decrement_50" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-minus small"/></button>
                                        <field name="qty_50" nolabel="1" class="form-control text-center px-1" style="max-width: 50px; font-size: 1.1rem;"/>
