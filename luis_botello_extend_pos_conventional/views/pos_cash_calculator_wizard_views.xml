                                <div class="col-6 d-flex align-items-center mb-1 px-3">
                                    <div class="input-group" style="width: auto;">
                                        <button name="decrement_5" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-minus small"/></button>
                                        <field name="qty_5" nolabel="1" class="form-control text-center px-1" style="max-width: 50px; font-size: 1.1rem;"/>
                                        <button name="increment_5" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-plus small"/></button>
                                    </div>
                                    <label for="qty_5" string="5 €" class="m-0 fw-bold ms-2 whitespace-nowrap"/>
                                </div>
                            </div>

                            <h5 class="text-uppercase fw-bold border-bottom pb-2 mb-3">Monedas</h5>
                            <div class="row g-2">
                                <div class="col-6 d-flex align-items-center mb-1 px-3">
                                    <div class="input-group" style="width: auto;">
                                        <button name="decrement_2" type="object" class="btn btn-outline-secondary px-2 py-1"><i class="fa fa-minus small"/></button>
                                        <field name="qty_2" nolabel="1" class="form-control text-center px-1" style="max-width: 50px; font-size: 1.1rem;"/>
