<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_by_warehouse_list" model="ir.ui.view">
        <field name="name">stock.quant.list.by.warehouse</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total"/>
                <field name="reserved_quantity" sum="Total" optional="hide"/>
                <field name="available_quantity" sum="Total"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
            </list>
        </field>
    </record>

    <record id="action_stock_by_warehouse" model="ir.actions.act_window">
        <field name="name">Stock por almacén</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="luis_botello_product_stock_margin.view_stock_by_warehouse_list"/>
        <field name="context">{'group_by': ['warehouse_id']}</field>
    </record>

    <record id="product_template_form_view_stock_margin" model="ir.ui.view">
        <field name="name">product.template.form.stock.margin</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_product_tmpl_forecast_report']" position="after">
                <button type="object" name="action_view_stock_by_warehouse"
                        class="oe_stat_button" icon="fa-building-o"
                        string="Ver stock"
                        invisible="not is_storable"
                        groups="stock.group_stock_user"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_margin" model="ir.ui.view">
        <field name="name">product.template.form.margin</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='standard_price_uom']" position="after">
                <label for="margin_amount" string="Margen de beneficio" groups="luis_botello_permisions.group_show_margin"
                       invisible="type == 'combo'
                                  or (not is_product_variant and (
                                      product_variant_count &gt; 1
                                      or (product_variant_count == 0 and is_dynamically_created)
                                  ))"/>
                <div name="margin_info" groups="luis_botello_permisions.group_show_margin"
                     invisible="type == 'combo'
                                or (not is_product_variant and (
                                    product_variant_count &gt; 1
                                    or (product_variant_count == 0 and is_dynamically_created)
                                ))">
                    <field name="margin_amount" widget="monetary" class="oe_inline"
                           options="{'currency_field': 'cost_currency_id'}"/>
                    <span class="oe_inline"> (</span>
                    <field name="margin_percent" class="oe_inline"/>
                    <span class="oe_inline"> %)</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
