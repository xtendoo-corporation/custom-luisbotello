<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_quant_tree_count_add" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.count.add</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">product_id, location_id, inventory_date, package_id, lot_id, owner_id</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="before">
                <field name="product_id" position="move"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_count_add_session_form" model="ir.ui.view">
        <field name="name">stock.count.add.session.form</field>
        <field name="model">stock.count.add.session</field>
        <field name="arch" type="xml">
            <form string="Conteo aditivo">
                <sheet>
                    <field name="last_message" widget="html" nolabel="1"
                           readonly="1" invisible="not last_message"/>
                    <group>
                        <group string="Sesión">
                            <field name="location_id"
                                   options="{'no_create': True}"/>
                            <field name="tracking" invisible="1"/>
                        </group>
                        <group string="Entrada">
                            <field name="barcode"
                                   placeholder="Escanear código..."/>
                            <field name="product_id"
                                   options="{'no_create': True}"/>
                            <field name="lot_id"
                                   options="{'no_create': True}"
                                   invisible="tracking not in ('lot', 'serial')"
                                   required="tracking in ('lot', 'serial')"/>
                            <field name="package_id"
                                   options="{'no_create': True}"/>
                            <field name="qty"/>
                        </group>
                    </group>
                    <group string="Entradas de esta sesión">
                        <field name="line_ids" nolabel="1" colspan="2">
                            <list string="Entradas" create="false" edit="false">
                                <field name="product_id"/>
                                <field name="location_id"/>
                                <field name="lot_id"
                                       optional="show"/>
                                <field name="package_id"
                                       optional="hide"/>
                                <field name="qty"/>
                                <field name="result_qty"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirmar" class="btn-primary"/>
                    <button name="action_finish" type="object"
                            string="Finalizar" class="btn-secondary"/>
                    <button string="Cerrar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_count_add_session" model="ir.actions.act_window">
        <field name="name">Conteo aditivo</field>
        <field name="res_model">stock.count.add.session</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>
